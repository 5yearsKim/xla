# Operator variables preserve kind, attrs, and arity across each rule.
# Property checks select supported operators and enforce types and policy.
# Floating-point/complex reassociation, distribution, and homogeneity require
# AllowReassociation. Associativity, linearity, and homogeneity checks require
# provable types. Scaling uses explicit rank-zero scalars.
# Strict mode preserves floating evaluation.

rule commute-binary-operator {
  F(?x, ?y) => F(?y, ?x)
  where Commutative(F);
}

rule associate-binary-operator-right {
  F(F(?x, ?y), ?z) => F(?x, F(?y, ?z))
  where Associative(F);
}

rule associate-binary-operator-left {
  F(?x, F(?y, ?z)) => F(F(?x, ?y), ?z)
  where Associative(F);
}

# Negate and self-inverse transposes are checked against every occurrence.
rule eliminate-double-involution {
  F(F(?x)) => ?x
  where Involution(F);
}

rule distribute-left-linear-operator-over-add {
  F(add(?x, ?y), ?a)
    => add(F(?x, ?a), F(?y, ?a))
  where LinearIn(F, 0);
}

rule distribute-right-linear-operator-over-add {
  F(?a, add(?x, ?y))
    => add(F(?a, ?x), F(?a, ?y))
  where LinearIn(F, 1);
}

rule factor-left-linear-operator-from-add {
  add(F(?x, ?a), F(?y, ?a))
    => F(add(?x, ?y), ?a)
  where LinearIn(F, 0);
}

rule factor-right-linear-operator-from-add {
  add(F(?a, ?x), F(?a, ?y))
    => F(?a, add(?x, ?y))
  where LinearIn(F, 1);
}

# scale(s, x) matches scalar broadcasts and rebuilds them at the RHS shape.
rule move-scaling-out-of-left-operand {
  F(scale(?s, ?x), ?a)
    => scale(?s, F(?x, ?a))
  where HomogeneousIn(F, 0) and Scalar(?s);
}

rule move-scaling-out-of-right-operand {
  F(?a, scale(?s, ?x))
    => scale(?s, F(?a, ?x))
  where HomogeneousIn(F, 1) and Scalar(?s);
}

rule distribute-unary-linear-operator-over-add {
  F(add(?x, ?y)) => add(F(?x), F(?y))
  where LinearIn(F, 0);
}

rule factor-unary-linear-operator-from-add {
  add(F(?x), F(?y)) => F(add(?x, ?y))
  where LinearIn(F, 0);
}

rule move-uniform-scaling-out-of-unary-operator {
  F(scale(?s, ?x)) => scale(?s, F(?x))
  where HomogeneousIn(F, 0) and Scalar(?s);
}
