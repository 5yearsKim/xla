load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "rewrite_cli_options",
    srcs = ["rewrite_cli_options.cc"],
    hdrs = ["rewrite_cli_options.h"],
    deps = [
        "//research/joint_shard/transforms:rewrite_options",
        "@cxxopts//:cxxopts",
    ],
)

cc_binary(
    name = "run_shardy",
    srcs = ["run_shardy.cc"],
    data = ["//research/joint_shard/testdata:samples"],
    deps = [
        "//research/joint_shard/reporting:artifact_writer",
        "//research/joint_shard/sharding:shardy_runner",
        "@cxxopts//:cxxopts",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Parser",
        "@shardy//shardy/dialect/sdy/ir:register",
        "@stablehlo//:register",
    ],
)

cc_binary(
    name = "parse_stablehlo",
    srcs = ["parse_stablehlo.cc"],
    deps = [
        ":rewrite_cli_options",
        "//research/joint_shard/reporting:reports",
        "//research/joint_shard/transforms:rewrite_regions",
        "@cxxopts//:cxxopts",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Parser",
        "@shardy//shardy/dialect/sdy/ir:register",
        "@stablehlo//:register",
    ],
)

cc_binary(
    name = "summarize_regions",
    srcs = ["summarize_regions.cc"],
    data = ["//research/joint_shard/testdata:samples"],
    deps = [
        "//research/joint_shard/export:selected_export",
        ":rewrite_cli_options",
        "//research/joint_shard/reporting:artifact_writer",
        "//research/joint_shard/reporting:reports",
        "//research/joint_shard/search:region_optimizer",
        "//research/joint_shard/transforms:rewrite_options",
        "@cxxopts//:cxxopts",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Parser",
        "@shardy//shardy/dialect/sdy/ir:register",
        "@stablehlo//:register",
    ],
)

cc_test(
    name = "rewrite_cli_options_test",
    srcs = ["rewrite_cli_options_test.cc"],
    deps = [
        ":rewrite_cli_options",
        "//research/joint_shard/transforms:rewrite_options",
        "@com_google_googletest//:gtest_main",
        "@cxxopts//:cxxopts",
    ],
    linkstatic = True,
)

cc_binary(
    name = "workload_ablation",
    srcs = ["workload_ablation.cc"],
    deps = [
        ":rewrite_cli_options",
        "//research/joint_shard/bridge:stablehlo_importer",
        "//research/joint_shard/export:selected_export",
        "//research/joint_shard/sharding:module_statistics",
        "//research/joint_shard/sharding:plan_materializer",
        "//research/joint_shard/sharding:region_evaluator",
        "//research/joint_shard/transforms:region_candidates",
        "@cxxopts//:cxxopts",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Parser",
        "@shardy//shardy/dialect/sdy/ir:register",
        "@stablehlo//:register",
    ],
)
